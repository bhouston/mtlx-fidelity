{
  "name": "mtlx-fidelity",
  "version": "0.1.0",
  "private": true,
  "description": "MaterialX fidelity test system for reference image generation and comparison workflows.",
  "keywords": [
    "fidelity",
    "materialx",
    "rendering",
    "testing"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build:deps": "tsc -p submodules/material-viewer/packages/mtlx-core && tsc -p submodules/material-viewer/packages/materialx-three",
    "build": "pnpm build:deps && pnpm --filter ./submodules/three.js build && pnpm -r --if-present --filter './packages/**' build",
    "dev": "pnpm -r --parallel --stream dev",
    "clean": "rimraf dist packages/**/dist",
    "clean:all": "pnpm clean && rimraf node_modules packages/**/node_modules",
    "prepare": "husky",
    "format": "oxfmt .",
    "lint": "oxlint packages docs tools vitest.config.ts",
    "lint:fix": "oxlint --fix packages docs tools vitest.config.ts",
    "tsc": "pnpm build:deps && pnpm -r --if-present --filter './packages/**' tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "pnpm --filter @mtlx-fidelity/cli start",
    "fidelity:process": "pnpm fidelity:prepare && fidelity-kit process submodules/mtlx-sample-library/materials",
    "fidelity:dev": "pnpm fidelity:prepare && fidelity-kit dev submodules/mtlx-sample-library/materials",
    "fidelity:build": "pnpm fidelity:prepare && fidelity-kit build submodules/mtlx-sample-library/materials --out site/",
    "fidelity:prepare": "node scripts/prepare-results.mjs"
  },
  "dependencies": {
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.2",
    "fidelity-kit": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
