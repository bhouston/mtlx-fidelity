{
  "name": "mtlx-fidelity",
  "version": "0.1.0",
  "private": true,
  "description": "MaterialX fidelity test system for reference image generation and comparison workflows.",
  "keywords": [
    "fidelity",
    "materialx",
    "rendering",
    "testing"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm --filter ./submodules/three.js build && pnpm -r --if-present --filter '!./submodules/three.js' build",
    "dev": "pnpm -r --parallel --stream dev",
    "clean": "rimraf dist packages/**/dist",
    "clean:all": "pnpm clean && rimraf node_modules packages/**/node_modules",
    "prepare": "husky",
    "format": "oxfmt .",
    "lint": "oxlint packages docs tools vitest.config.ts",
    "lint:fix": "oxlint --fix packages docs tools vitest.config.ts",
    "tsc": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "pnpm --filter @mtlx-fidelity/cli start",
    "viewer": "pnpm --filter @mtlx-fidelity/viewer dev",
    "viewer:build": "pnpm --filter @mtlx-fidelity/viewer build"
  },
  "dependencies": {
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
