{
  "name": "@mtlx-fidelity/renderer-threejs",
  "version": "0.1.0",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "viewer"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
